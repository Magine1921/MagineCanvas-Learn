{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "magine-trial",
  "main": "scripts/cloudflare-static-trial-worker.ts",
  "compatibility_date": "2026-07-16",
  "assets": {
    "directory": ".cloudflare-trial-static",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "MAGINE_WEB_EDITION": "trial",
    "MAGINE_WEB_FEATURES_LIMITED": "1"
  }
}
